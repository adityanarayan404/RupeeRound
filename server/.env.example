# Copy to server/.env and fill in.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
PORT=4000
# Comma-separated list of frontend URLs allowed to call the API (needed once deployed).
CLIENT_ORIGIN=http://localhost:8443
# Every OTP is this code; there is no SMS provider in the prototype.
DEMO_OTP=123456
# How long fetched fund NAVs are reused before asking mfapi.in again.
NAV_CACHE_HOURS=6
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
